# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is git-ignored: never commit real values.
#
# Only needed if you deploy from your own machine with Wrangler
# (npx wrangler pages deploy dist). Deploying through the Cloudflare
# dashboard's "Connect to Git" needs none of these.

# Cloudflare dashboard > right sidebar on the account home page, "Account ID"
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare dashboard > My Profile > API Tokens > Create Token
# Use the "Edit Cloudflare Workers" template, or a custom token with
# Account > Cloudflare Pages > Edit
CLOUDFLARE_API_TOKEN=

# GitHub needs no entry here: run `gh auth login` once instead.
