{
  "name": "currency-time-machine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:contest": "vite build --mode contest && python scripts/strip_people.py dist",
    "preview": "vite preview",
    "test": "python -m pytest -q && node --test tests/today.test.ts tests/trails.test.ts tests/portals.test.ts tests/history.test.ts tests/chart.test.ts tests/map.test.ts tests/layout.test.ts tests/annual.test.ts tests/guide.test.ts tests/narration.test.ts tests/i18n.test.ts",
    "media": "python scripts/build_media.py",
    "map": "python scripts/build_map.py",
    "leaders": "python scripts/build_leaders.py",
    "events": "python scripts/build_events.py",
    "rates": "python scripts/check_rates.py",
    "review": "python scripts/review_featured.py",
    "i18n": "node scripts/i18n.ts",
    "i18n:check": "node scripts/i18n.ts --check",
    "names:ja": "python scripts/build_names_ja.py",
    "voice:lines": "node scripts/voice-lines.ts",
    "voice:estimate": "python scripts/voice_tool.py estimate",
    "check:build": "python scripts/check_build.py dist --mode full",
    "check:contest": "python scripts/check_build.py dist --mode contest",
    "data": "python scripts/build_history.py",
    "pacing": "node scripts/simulate-pacing.ts"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0-rc.2",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.185.0"
  },
  "devDependencies": {
    "@iwsdk/reference": "1.1.0-rc.2",
    "@iwsdk/cli": "1.1.0-rc.2",
    "@iwsdk/vite-plugin-dev": "1.1.0-rc.2",
    "@meta-quest/metavr": "^1.8.1",
    "@types/three": "^0.185.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.185.0"
  },
  "engines": {
    "node": ">=22.18.0 <23.0.0-0 || >=24.0.0"
  }
}
