<!--
  Caption board, floating ahead and slightly above the orbs.
  Large, high-contrast type (white on near-black); the year is always shown so
  the passage of time is readable at a glance. Sizes are UIKit units and the
  entity is scaled by 0.1 in code (so font-size 30 is ~3 cm tall in VR).
-->
<style>
  .root {
    flex-direction: column;
    align-items: center;
    width: 680;
    padding-top: 16;
    padding-bottom: 20;
    padding-left: 30;
    padding-right: 30;
    gap: 6;
    border-radius: 20;
    border-width: 2;
    border-color: #33405e;
    background-color: #060a14;
  }

  .year {
    color: #ffffff;
    font-size: 64;
    font-weight: 700;
  }

  .caption {
    flex-direction: column;
    align-items: center;
    gap: 6;
    width: 620;
  }

  .label {
    color: #ffd84a;
    font-size: 30;
    font-weight: 700;
  }

  .text {
    color: #f4f6fa;
    font-size: 36;
    text-align: center;
    width: 620;
  }

  .hint {
    flex-direction: row;
    align-items: center;
    gap: 14;
    width: 620;
  }

  .hint-icon {
    width: 44;
    height: 44;
    color: #ffd84a;
  }

  .hint-text {
    color: #f4f6fa;
    font-size: 34;
    width: 560;
  }
</style>
<div class="root" id="caption-root">
  <div class="year" id="year-text">1948</div>
  <div class="caption" id="caption-box" style="display: none">
    <div class="label" id="caption-label">1948</div>
    <div class="text" id="caption-text">.</div>
  </div>
  <div class="hint" id="hint-box" style="display: none">
    <Hand class="hint-icon"></Hand>
    <div class="hint-text" id="hint-text">.</div>
  </div>
</div>
